{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "WordPress/WordPress#6.7",
  "phpVersion": "8.2",
  "plugins": [
    "./wordpress/wp-content/plugins/ishot-booking"
  ],
  "themes": [
    "./wordpress/wp-content/themes/ishot-concept"
  ],
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "SCRIPT_DEBUG": true
  },
  "env": {
    "development": {
      "port": 8888,
      "mappings": {
        "wp-content/mu-plugins/ishot-mailpit.php": "./wordpress/dev/mu-plugins/ishot-mailpit.php",
        "wp-content/ishot-dev": "./wordpress/dev",
        "wp-content/ishot-seed": "./wordpress/seed",
        "wp-content/ishot-prototype-images": "./public/images/opt"
      }
    },
    "tests": {
      "port": 8889
    }
  }
}
