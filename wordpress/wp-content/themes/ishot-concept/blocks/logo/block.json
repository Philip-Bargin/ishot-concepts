{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ishot/logo",
	"title": "iShot logo",
	"category": "theme",
	"description": "The official iShot Concept logo files. Auto swaps to the reversed file in Night; reversed is for navy bands. Link wraps it in the home link.",
	"attributes": {
		"variant": {
			"type": "string",
			"enum": [ "auto", "reversed" ],
			"default": "auto"
		},
		"isLink": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"inserter": false
	},
	"textdomain": "ishot-concept",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
