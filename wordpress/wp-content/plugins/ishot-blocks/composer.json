{
  "name": "ishot/ishot-blocks",
  "description": "Reusable content blocks for the iShot Concept site. Content survives a theme change; booking logic stays in ishot-booking.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": { "IShot\\Blocks\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "IShot\\Blocks\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit"
  },
  "config": {
    "sort-packages": true,
    "platform": { "php": "8.2" }
  }
}
