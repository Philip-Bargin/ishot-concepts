{
  "name": "ishot/ishot-booking",
  "description": "Booking management for the iShot Concept studio: availability, conflict-safe bookings, deposits and notifications.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "woocommerce/action-scheduler": "^3.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": { "IShot\\Booking\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "IShot\\Booking\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit"
  },
  "config": {
    "sort-packages": true,
    "platform": { "php": "8.2" }
  }
}
