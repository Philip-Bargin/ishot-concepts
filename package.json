{
  "name": "ishot-concept",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync:ds": "node scripts/sync-design-system.mjs",
    "predev": "npm run sync:ds",
    "dev": "vite",
    "prebuild": "npm run sync:ds && npm run lint:tokens",
    "build": "vite build",
    "preview": "vite preview",
    "preview:build": "npm run build && node scripts/prepare-preview.mjs",
    "images": "node scripts/optimize-images.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "wp:start": "wp-env start",
    "wp:stop": "wp-env stop",
    "mail:start": "docker start ishot-mailpit || docker run -d --name ishot-mailpit -p 8026:8025 -p 1026:1025 axllent/mailpit",
    "mail:stop": "docker stop ishot-mailpit",
    "wp:setup": "wp-env run tests-cli --env-cwd=wp-content/plugins/ishot-booking composer install --no-interaction",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/ishot-booking vendor/bin/phpunit",
    "test:php:unit": "wp-env run tests-cli --env-cwd=wp-content/plugins/ishot-booking vendor/bin/phpunit --testsuite unit",
    "seed:export": "node scripts/export-wp-seed.mjs",
    "wp:import": "npm run seed:export && wp-env run cli wp ishot import-prototype --seed=wp-content/ishot-seed/prototype-content.json --images=wp-content/ishot-prototype-images"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.1.1",
    "@fontsource/space-grotesk": "^5.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@wordpress/env": "^10.14.0",
    "axe-core": "^4.10.2",
    "sharp": "^0.33.5",
    "vite": "^5.4.8"
  }
}
