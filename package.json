{
  "name": "ishot-concept",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync:ds": "node scripts/sync-design-system.mjs",
    "predev": "npm run sync:ds",
    "dev": "vite",
    "prebuild": "npm run sync:ds && npm run lint:tokens",
    "build": "vite build",
    "preview": "vite preview",
    "preview:build": "npm run build && node scripts/prepare-preview.mjs",
    "images": "node scripts/optimize-images.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "wp:start": "wp-env start",
    "wp:stop": "wp-env stop",
    "mail:start": "docker start ishot-mailpit || docker run -d --name ishot-mailpit -p 8026:8025 -p 1026:1025 axllent/mailpit",
    "mail:stop": "docker stop ishot-mailpit",
    "wp:setup": "wp-env run tests-cli --env-cwd=wp-content/plugins/ishot-booking composer install --no-interaction && wp-env run tests-cli --env-cwd=wp-content/plugins/ishot-blocks composer install --no-interaction",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/ishot-booking vendor/bin/phpunit",
    "test:php:unit": "wp-env run tests-cli --env-cwd=wp-content/plugins/ishot-booking vendor/bin/phpunit --testsuite unit",
    "seed:export": "node scripts/export-wp-seed.mjs",
    "wp:import": "npm run seed:export && wp-env run cli wp ishot import-prototype --seed=wp-content/ishot-seed/prototype-content.json --images=wp-content/ishot-prototype-images",
    "qa": "node scripts/qa.mjs",
    "visual:reference": "node scripts/visual-reference.mjs",
    "test:visual": "node scripts/visual-reference.mjs --check",
    "test:visual:wp": "node scripts/visual-reference.mjs --check --target wp",
    "test:a11y": "node scripts/run-visual-spec.mjs a11y",
    "test:a11y:wp": "node scripts/run-visual-spec.mjs a11y --target wp",
    "test:blocks": "wp-env run tests-cli --env-cwd=wp-content/plugins/ishot-blocks vendor/bin/phpunit --testsuite unit,integration",
    "test:theme": "wp-env run tests-cli --env-cwd=wp-content/plugins/ishot-blocks vendor/bin/phpunit --testsuite theme",
    "build:icons": "node scripts/export-icons.mjs",
    "build:blocks": "node scripts/build-blocks.mjs",
    "start:blocks": "node scripts/build-blocks.mjs --watch",
    "build:blocks:check": "node scripts/build-blocks.mjs --check",
    "test:e2e": "playwright test --config playwright.e2e.config.mjs",
    "test:scripts": "node --test tests/blocks/*.test.mjs tests/visual/*.test.mjs tests/dev/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.1.1",
    "@fontsource/space-grotesk": "^5.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@wordpress/env": "^10.14.0",
    "@wordpress/scripts": "35.0.0",
    "axe-core": "^4.10.2",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "sharp": "^0.33.5",
    "vite": "^5.4.8"
  }
}
